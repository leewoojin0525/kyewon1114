# Copy to .env. Use scripts/local-setup.ts to generate local secrets; never commit secrets.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
APP_URL=http://127.0.0.1:3000
DATABASE_URL=
PAYLOAD_SECRET=
RATE_LIMIT_SECRET=
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
MEDIA_DIRECTORY=.data/media
# Production: private S3/R2 bucket; no public bucket policy
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAIL_ADAPTER=test
ALLOW_EXTERNAL_MAIL=false
RESEND_API_KEY=
MAIL_FROM=
NOTIFICATION_TO=
WORKER_SECRET=
CRON_SECRET=
# Set only behind an ingress that removes incoming X-Real-IP and sets its own.
TRUST_PROXY=false
CMS_SCHEMA_PUSH=false
