{
  "name": "wovn-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "local:setup": "node --import tsx scripts/local-setup.ts",
    "local:db": "node --import tsx scripts/local-db.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "cms:migrate": "payload migrate",
    "cms:types": "payload generate:types",
    "owner:create": "node --import tsx scripts/create-owner.ts",
    "worker": "node --import tsx scripts/worker.ts",
    "test": "node --import tsx --test --test-force-exit --test-concurrency=1 tests/*.test.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "release:check": "node --import tsx scripts/release-check.ts",
    "local:accounts": "node --import tsx scripts/local-accounts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.922.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/noto-sans-kr": "5.2.9",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@vercel/blob": "2.9.0",
    "graphql": "16.12.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.34.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  }
}
